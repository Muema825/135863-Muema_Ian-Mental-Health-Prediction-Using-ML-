# Copy to .env (or export in your shell) and fill in real values.
# Never commit the real .env file.

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: path to the SQLite database file (defaults to ./db.sqlite3)
# DJANGO_DB_PATH=/path/to/db.sqlite3

# Email (SMTP) used for account activation / welcome emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-app-password

# Optional: path to a Google service-account JSON key, stored outside the repo
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
